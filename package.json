{
  "name": "ugo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "db:generate": "pnpm --filter @ugo/db db:generate",
    "db:migrate": "pnpm --filter @ugo/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.0": ">=0.35.0",
      "fast-uri@<3.1.7": "^3.1.7",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "undici@>=8 <8.10.2": "^8.10.2",
      "brace-expansion@>=2 <2.1.6": "^2.1.6",
      "brace-expansion@>=5 <5.0.11": "^5.0.11",
      "@grpc/grpc-js@<1.14.5": "^1.14.5"
    }
  }
}
