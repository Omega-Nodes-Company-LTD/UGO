{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "UGO_TEST_OLLAMA_MODELS",
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "SSL_CERT_FILE",
        "NODE_EXTRA_CA_CERTS"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build",
        "soul#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "UGO_TEST_OLLAMA_MODELS",
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "PLAYWRIGHT_*",
        "UGO_CHROMIUM_PATH",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "SSL_CERT_FILE",
        "NODE_EXTRA_CA_CERTS"
      ]
    },
    "db:generate": {
      "cache": false
    }
  }
}
