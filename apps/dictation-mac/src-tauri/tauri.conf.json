{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UGO Dettatura",
  "version": "0.1.0",
  "identifier": "ai.omeganodes.dictation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UGO Dettatura",
        "url": "index.html",
        "width": 420,
        "height": 440,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Detta in qualunque app, trascritto dal faster-whisper di UGO",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
