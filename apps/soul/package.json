{
  "name": "soul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "ugo": "tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ugo/db": "workspace:*",
    "@ugo/memory": "workspace:*",
    "@ugo/prompts": "workspace:*",
    "@ugo/psyche": "workspace:*",
    "@ugo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "mqtt": "^5.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "@ugo/factories": "workspace:*",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  }
}
