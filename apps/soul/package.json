{
  "name": "soul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "echo 'no unit tests: soul is I/O wiring (see TESTING_PLAYBOOK §1)'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ugo/db": "workspace:*",
    "@ugo/memory": "workspace:*",
    "@ugo/psyche": "workspace:*",
    "@ugo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "mqtt": "^5.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.19.0",
    "@ugo/factories": "workspace:*",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
