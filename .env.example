# ============================================================================
# UGO — Variabili d'ambiente (PROGETTO §10)
# ----------------------------------------------------------------------------
# Copia questo file in `.env` e valorizza le variabili. MAI committare `.env`.
# In produzione i segreti vengono iniettati dalle variabili criptate di
# Coolify: nessun file .env sul server.
# soul-api fa fail-fast all'avvio se una variabile richiesta manca o è
# malformata (elenca i NOMI mancanti, mai i valori).
# ============================================================================

# --- Fase 0 — richieste ora -------------------------------------------------

# Postgres 16 + pgvector. In compose i valori POSTGRES_* creano il database;
# DATABASE_URL è ciò che soul-api e le migrazioni usano per connettersi.
# L'host `postgres` è il nome del servizio sulla rete Docker privata.
POSTGRES_DB=ugo
POSTGRES_USER=ugo
# Genera con: openssl rand -base64 24
POSTGRES_PASSWORD=<genera-una-password-robusta>
DATABASE_URL=postgres://ugo:<stessa-password>@postgres:5432/ugo
# ADR-062 tempo 2b — IL FLIP: l'utenza applicativa su cui le politiche RLS
# mordono davvero. Si crea la password con:
#   ALTER ROLE ugo_app LOGIN PASSWORD '<password-diversa-dall-owner>';
# e si imposta questa variabile. Assente = si resta sull'owner (muro inerte).
# Le migrazioni usano SEMPRE DATABASE_URL: i privilegi non si applicano al
# proprietario delle tabelle, ed è per questo che sono due utenze.
# DATABASE_URL_APP=postgres://ugo_app:<password-app>@postgres:5432/ugo

# Mosquitto (MQTT). Utente dedicato a soul-api; il device Nano ha credenziali
# proprie con ACL ristretta (vedi ops/docker/mosquitto/acl.conf).
# Il password file è generato da ops/docker/mosquitto/generate-passwd.sh
# a partire da questi valori — non è mai committato.
# MQTT serve SOLO al firmware Nano 33 (accantonato): lascia vuote le tre righe
# e /health riporterà mqtt: "off", che non è un guasto.
MQTT_URL=
MQTT_USER=soul
# Genera con: openssl rand -base64 24
MQTT_PASS=<genera-una-password-robusta>
# Credenziali del firmware Nano 33 IoT (usate solo dallo script passwd/ACL)
MQTT_NANO_USER=nano
MQTT_NANO_PASS=<genera-una-password-robusta>

# Ollama su CPU, rete Docker privata. Nessuna porta host.
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ADR-110 — il nodo con la scheda video, se c'è. Vuota (il default): tutto
# gira su OLLAMA_URL e non cambia niente. Valorizzata: ci vanno il modello
# vision, il testo locale e l'anello di casa della catena di chat.
#
# Gli EMBEDDING restano su OLLAMA_URL, sempre: sono l'unico client locale che
# lancia invece di degradare, e una seconda macchina in mezzo li renderebbe
# una dipendenza dura (ADR-110 §3).
#
# ATTENZIONE, e non è una nota di stile: Ollama NON ha autenticazione, e fra
# due macchine la rete Docker `internal: true` non esiste più. L'unico muro è
# la tailnet — un indirizzo qui che non sia dentro di essa pubblica il modello
# a chiunque (OPS_COOLIFY §2.3).
# OLLAMA_GPU_URL=http://<TAILSCALE_IP_GPU>:11434

# Porta HTTP di soul-api (esposta solo su 127.0.0.1 in dev, tailnet in prod)
PORT=3000

# Fuso orario di riferimento del progetto (cron del sogno: 02:30 Europe/Rome)
TZ=Europe/Rome

# Token bearer per le rotte distruttive/costose di soul (oblio, export,
# trigger del sogno, join riunione, presign upload). Genera con:
# openssl rand -hex 32
# OBBLIGATORIO se NODE_ENV=production: soul si rifiuta di avviarsi senza.
# La faccia lo riceve via URL (?token=...) quando gira in modalità portable.
UGO_INTERNAL_TOKEN=<openssl-rand-hex-32>

# --- Riconoscimento delle persone (ADR-045) ------------------------------
# Assente = UGO risponde senza sapere chi ha davanti, che è il comportamento
# di ogni versione fino alla 0.26: la biometria si accende, non si subisce.
# Il servizio sta sulla rete interna e non pubblica porte.
# La leggono in DUE: soul (identificazione dal vivo) e i job (l'arruolamento
# vocale del sogno passa dalla percezione, dove vive ECAPA — il fix della
# voce dimenticata, 2026-08-16)
UGO_RECOGNITION_URL=http://percezione:8000
# Dove stanno i pesi (~250 MB). NON c'è niente da lanciare: il container se li
# scarica da solo al primo avvio e li verifica (SHA-256), PRIMA di aprire la
# porta. Serve solo che sia un volume persistente e scrivibile, o li riscarica
# a ogni riavvio.
UGO_MODELS_DIR=./models
# Opzionale: endpoint HTTP del runner jobs per il trigger manuale del sogno.
# Se assente, POST /v1/jobs/dream registra la richiesta e risponde 202
# "partirà alla prossima esecuzione schedulata".
# UGO_JOBS_TRIGGER_URL=
# ADR-025: dopo quanti minuti di casa vuota UGO usa la pausa per mettere in
# ordine cio che sa (versione leggera del sogno: contraddizioni, entita,
# igiene). 0 spegne la funzione. Il tetto di spesa resta UGO_DAILY_BUDGET_USD.
UGO_IDLE_CONSOLIDATION_MINUTES=90
# L'ora del sogno vero (HH:MM nel fuso di TZ). Serve a soul solo per starne
# alla larga: il runner dei job legge la stessa variabile per schedularsi.
UGO_DREAM_AT=02:30

# Opzionale: mappa dei canali per specie (ADR-016), JSON. Se assente vale la
# mappa di default (human/parrot/dog/reptile/unknown). Un JSON malformato
# blocca il boot: meglio non partire che trattare un rettile come un umano.
# UGO_SPECIES_MAP={"ferret":{"channels":["vision"],"identity":"declared","interact":false,"rule":"..."}}

# --- Fase 1 — Anima minima (richieste da ora) --------------------------------

# Chiave API Anthropic. L'UNICO punto del codice autorizzato a usarla è
# packages/memory/llmClient (budget guard, CLAUDE.md regola 3).
ANTHROPIC_API_KEY=<da-console-anthropic>
UGO_CHAT_MODEL=claude-haiku-4-5
# ADR-094 — la voce di casa parla per prima: la chat prova PRIMA il modello
# locale su Ollama, e il provider è il soccorso quando casa non risponde
# (giù, lenta, o risposta vuota). on|off; se non valorizzata è ON.
# UGO_CHAT_LOCAL_FIRST=on
# Il modello locale della chat. Se non valorizzato usa OLLAMA_TEXT_MODEL,
# e in mancanza OLLAMA_BATCH_MODEL (già scaricato sul server).
# OLLAMA_CHAT_MODEL=qwen2.5:3b
# ADR-095 — il secondo anello della catena (casa → OpenRouter → Anthropic).
# Solo con la chiave; la chiave senza il modello blocca il boot. Ogni anello
# che risponde scrive la sua riga su budget_ledger col suo listino: anche la
# voce di casa paga, a listino nominale (~1% di haiku), e il metabolismo gira
# su tutti.
# OPENROUTER_API_KEY=<da-openrouter.ai>
# OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-72b-instruct
# Tetto di spesa giornaliero in USD. Superato: degradazione dichiarata
# ("oggi ho finito le parole"). Conteggio sempre server-side su budget_ledger.
# Vale anche per il sogno (ADR-023): a budget esaurito i passi notturni che
# userebbero il fallback API si fermano invece di spendere, e riprovano domani.
# Un account con `accounts.daily_budget_usd` proprio sovrascrive questo valore.
UGO_DAILY_BUDGET_USD=0.50
# ADR-103: quanto costa un cucciolo, PER CUCCIOLO. Si paga dal salvadanaio dei
# genitori e solo dalla terza generazione in poi: i figli di un capostipite
# sono gratis, perche far pagare l'inizio di una stirpe e far pagare l'inizio.
# La taglia della cucciolata non si sceglie (2..8, con 1 e 10 rarissimi), quindi
# il conto si vede nell'anteprima prima di dare i nomi. 0 = si nasce gratis.
UGO_LITTER_COST_USD=0.25
# Chiave AES-256-GCM per la cifratura applicativa a riposo di messaggi e
# trascrizioni. 32 byte in base64. Genera con: openssl rand -base64 32
# Va custodita SEPARATA dal database (rotazione: vedi docs/OPS_COOLIFY.md).
UGO_DATA_KEY=<openssl-rand-base64-32>
# Opzionale: override dell'endpoint API (usato solo dagli stub di test di
# rete; in produzione lasciare NON valorizzata → https://api.anthropic.com)
# ANTHROPIC_BASE_URL=

# --- Fase 3 — Vita interiore (richieste dal job del sogno) -------------------

# Modello MoE per il batch notturno su CPU (es. qwen3:30b-a3b)
# Modello per la riflessione notturna.
#   qwen3:30b-a3b  -> gratis e nulla esce dal nostro ferro; MoE, quindi su CPU
#                     ha una velocità sensata. Vuole ~24 GB di RAM per Ollama.
#   (vuoto)        -> fallback API Anthropic in batch, passa dal salvadanaio.
# In entrambi i casi, se il modello locale non risponde il sogno usa l'API.
OLLAMA_BATCH_MODEL=qwen3:30b-a3b

# ADR-027 — Iniziativa: UGO può cominciare lui.
# Il modello che gli dà le parole per una domanda sua. LOCALE, sempre: una
# cosa che parte da sola non deve poter spendere il budget API. Se non la
# valorizzi usa OLLAMA_BATCH_MODEL, che sul server è già stato scaricato;
# puntala a un modello più piccolo per domande più svelte.
# OLLAMA_TEXT_MODEL=qwen2.5:3b
# on|off — il DEFAULT del server. ADR-104: ogni account puo dire la sua dal
# pannello, e la sua scelta e scritta (sopravvive al riavvio) e vale SOLO per
# lui. Questa variabile decide per le case che non hanno mai scelto, e torna a
# decidere per una casa che clicca «Lascia decidere al server».
UGO_INITIATIVE=on
# ADR-107 — «non lo so». Prima di comporre i ricordi nel prompt, il modello di
# CASA guarda se rispondono davvero alla domanda; se no, UGO dice che non lo sa
# con parole sue invece di ricevere cinque ricordi che non c'entrano e inventare.
# Acceso di default per scelta del proprietario, misurato: evita dieci
# confabulazioni su dieci e costa un «non lo so» ogni dieci risposte vere.
# off = come prima, risponde sempre.
UGO_ABSTAIN=on
# ogni quanto si chiede se c'è qualcosa da fare (minuti)
UGO_INITIATIVE_TICK_MINUTES=4
# La ruminazione (ADR-059): da fermo pensa coi modelli LOCALI — accostamenti
# fra ricordi, domande da farti, due battute con l'altro gosino. Zero token
# del provider per costruzione; di notte tace (rumina il sogno).
UGO_RUMINATION=on
# minuti minimi fra un pensiero e l'altro, per gosino (contano i tentativi)
UGO_RUMINATION_GAP_MIN=45
# Opzionale: endpoint separato per il modello batch (fallback API batch,
# ADR-001). Se non valorizzata, il sogno usa OLLAMA_URL.
# OLLAMA_BATCH_URL=

# Gruppo 12 — il meteo vero e il cielo di stanotte. Facoltative: senza, il
# cielo del recinto resta quello di sempre. Coordinate della casa (open-meteo
# non vuole chiavi e non riceve altro; la chiamata la fa soul, mai il chiosco).
# UGO_HOME_LAT=41.9
# UGO_HOME_LON=12.5
# Gruppo 12 — il modello vision locale per le occhiate (moondream, llava…).
# Assente = UGO non dà occhiate: la visione si accende, non si subisce.
# OLLAMA_VISION_MODEL=moondream
# ADR-063 — la finestra sul mondo: «cerca: …» in chat passa da SearXNG in
# casa (container nel compose) + sintesi col modello locale. Zero costi.
# Assente = il prefisso non esiste e niente esce verso i motori.
# SEARXNG_URL=http://searxng:8080
# Gruppo 13 — la voce interim: TTS emotivo OpenAI finché non c'è la GPU per
# XTTS locale. ATTENZIONE dichiarata: ciò che UGO dice può contenere pezzi
# della vostra vita, e sintetizzarlo fuori casa è una scelta, non un default.
# Ogni frase scrive una riga di budget_ledger e rispetta il tetto giornaliero.
# OPENAI_API_KEY=
# UGO_TTS_MODEL=gpt-4o-mini-tts
# UGO_TTS_VOICE=alloy
# Decisione 2026-08-16 — la voce di casa: Piper sul servizio di percezione,
# gradino di mezzo di /v1/tts (provider → Piper → voce di sistema). Gratuita,
# niente esce di casa. Vuota = spenta. Il servizio scarica la voce al primo
# avvio, prima di aprire la porta (ADR-047).
# UGO_PIPER_VOICE=it_IT-paola-medium
# Gruppo 13 — la dettatura locale (faster-whisper sul servizio di percezione).
# Vuota = spenta: il chiosco resta sul riconoscitore del browser.
# UGO_STT_MODEL=small

# --- Fase 4 — In giro / audio (richieste da upload e ingest) -----------------

# Bucket S3 esistente: policy privata, SSE attivo. In soul-api l'upload
# presigned si attiva solo se TUTTE le S3_* sono valorizzate.
S3_ENDPOINT=<https-endpoint-s3>
# Accettati anche i nomi standard AWS, che sono quelli che vedi nel pannello
# del provider: S3_ACCESS_KEY_ID e S3_SECRET_ACCESS_KEY.
S3_ACCESS_KEY=
S3_SECRET_KEY=<secret-key>
S3_BUCKET_AUDIO=ugo-audio
# Region del provider: Hetzner la pretende (es. fsn1), gli altri la ignorano.
S3_REGION=us-east-1
S3_BUCKET_BACKUP=ugo-backup
# Retention audio grezzo in giorni (minimizzazione GDPR, PROGETTO §7)
UGO_AUDIO_RETENTION_DAYS=90
# Modello faster-whisper per la trascrizione notturna su CPU
UGO_WHISPER_MODEL=large-v3
# Token Hugging Face per pyannote (diarizzazione). Senza: fallback
# mono-speaker dichiarato (PROGETTO §11).

# --- Fase 5 — Riunioni (la feature meetings si attiva solo se entrambe presenti)

# Stack Vexa self-hosted (open-core v0.12: polling transcripts, vedi ADR-013)
VEXA_API_URL=<url-interno-stack-vexa>
VEXA_API_KEY=<da-deploy-vexa>
# Nome del proprietario per il display name del bot: "UGO 🐾 appunti di <nome>"
UGO_OWNER_NAME=<nome>

# ADR-019 fase 3 — di chi e' questa esecuzione dei job notturni.
# Assenti: il sogno serve TUTTE le case aperte, una per una, ciascuna col
# proprio fuso (`households.timezone`) — che e' come gira un vicinato su un
# ferro solo. Impostata UGO_HOUSEHOLD_ID: serve quella sola, che e' come si
# schiera un container per famiglia.
# UGO_GOSINO_ID e' un'ulteriore restrizione a un solo esemplare, e serve quasi
# soltanto a fare debug di una creatura per volta: normalmente il sogno cicla
# da se' su tutti gli esemplari della casa.
UGO_HOUSEHOLD_ID=
UGO_GOSINO_ID=
# quante notti di dump conservare nel bucket (era cablato a 30 e non letto)
UGO_BACKUP_RETENTION_DAYS=30

# --- La reception (ADR-051…055) — assistente ticket per i clienti ---------

# Il segreto di servizio della reception: DEDICATO, non il token interno —
# ruotare la superficie pubblica non deve toccare quella interna. Assente:
# la reception non esiste e le sue rotte non vengono registrate.
UGO_RECEPTION_TOKEN=<openssl-rand-hex-32>
# L'URL interno di soul visto dal container reception (compose: http://soul:3000)
SOUL_URL=http://soul:3000

# I contatori del cliente (ADR-055): default di processo, ogni cliente puo'
# avere i propri dal pannello, senza deploy.
UGO_CUSTOMER_HOURLY_MESSAGES=20
UGO_CUSTOMER_DAILY_BUDGET_USD=0.25
# Le mele che un cliente puo' dare in sette giorni (ADR-058): poche apposta —
# il premio significa qualcosa perche' e' raro. Override per cliente dal pannello.
UGO_CUSTOMER_WEEKLY_REWARDS=2

# Le fonti di conoscenza (ADR-054)
# bucket privato dei documenti dei clienti (upload dal pannello via presign)
S3_BUCKET_DOCS=ugo-docs
# ADR-109 — il secchio dell'ALBUM: le foto che una casa sceglie di tenere,
# cifrate con la sua chiave. Secchio suo e non quello dell'audio, perché una
# foto e una registrazione hanno durate e diritti diversi. Assente = l'album
# non ha dove conservare, e il pannello lo dice invece di far finta.
# La DURATA non sta qui: la sceglie la famiglia dal pannello, fra 6 e 72 ore
# — o «non si tengono», che è come nasce ogni casa.
S3_BUCKET_PHOTOS=ugo-photos
# ogni quante ore i job sincronizzano repo/email/documenti (0 = spento)
UGO_CUSTOMER_SYNC_EVERY_H=6
# I feed della casa (ADR-060): ogni quante ore scaricarli (0 = spento).
# L'incrocio con la conoscenza dei clienti lo fa il sogno, non questo giro.
UGO_FEEDS_EVERY_H=6
# tetto di chunk per singola fonte: un monorepo non deve mangiarsi il container
UGO_CUSTOMER_MAX_CHUNKS=5000

# --- Il libro genealogico (ADR-073) — la catena degli atti ----------------

# Il registrar vive in un CONTAINER SUO con un DATABASE SUO: un registro che
# vive dove vivono le anime non e' un dominio di fiducia separato, e allora
# non garantisce niente che non fosse gia' garantito da chi possiede quel
# database. Assenti: i gosini nascono lo stesso, senza atto in catena — una
# creatura non e' ostaggio della propria burocrazia.

# Quello che soul usa per presentare gli atti (compose: http://registry:3100)
UGO_REGISTRY_URL=http://registry:3100
# Il segreto per SCRIVERE sul registro. Leggere non richiede niente: un libro
# genealogico consultabile solo col permesso di chi lo tiene non e' un libro
# genealogico. Sulla catena non c'e' nessuna persona, solo id e impronte.
UGO_REGISTRY_TOKEN=<openssl-rand-hex-32>

# La chiave con cui il registrar FIRMA le voci (Ed25519 PKCS#8 in base64):
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
REGISTRY_SIGNING_KEY=<ed25519-pkcs8-der-base64>
# Come si chiama questo registrar quando testimonia presso gli altri
REGISTRY_NAME=ugo-registrar
# Il suo database, separato da quello delle anime
REGISTRY_DB=ugo_registry
REGISTRY_DB_USER=ugo_registry
REGISTRY_DB_PASSWORD=<openssl-rand-hex-24>
