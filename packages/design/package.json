{
  "name": "@ugo/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/emit.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
